; Built from runtime/godot by scripts/build-godot-runtime.mjs.
; The binaries are build outputs and are not tracked in Git.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

macos.debug = "res://addons/gamealgo/runtime/macos/libgamealgo_godot_runtime.dylib"
macos.release = "res://addons/gamealgo/runtime/macos/libgamealgo_godot_runtime.dylib"
ios.debug = "res://addons/gamealgo/runtime/ios/libgamealgo_godot_runtime.dylib"
ios.release = "res://addons/gamealgo/runtime/ios/libgamealgo_godot_runtime.dylib"
ios.debug.simulator = "res://addons/gamealgo/runtime/ios-simulator/libgamealgo_godot_runtime.dylib"
ios.release.simulator = "res://addons/gamealgo/runtime/ios-simulator/libgamealgo_godot_runtime.dylib"
android.debug.arm64 = "res://addons/gamealgo/runtime/android/arm64-v8a/libgamealgo_godot_runtime.so"
android.release.arm64 = "res://addons/gamealgo/runtime/android/arm64-v8a/libgamealgo_godot_runtime.so"
android.debug.arm32 = "res://addons/gamealgo/runtime/android/armeabi-v7a/libgamealgo_godot_runtime.so"
android.release.arm32 = "res://addons/gamealgo/runtime/android/armeabi-v7a/libgamealgo_godot_runtime.so"
android.debug.x86_64 = "res://addons/gamealgo/runtime/android/x86_64/libgamealgo_godot_runtime.so"
android.release.x86_64 = "res://addons/gamealgo/runtime/android/x86_64/libgamealgo_godot_runtime.so"
